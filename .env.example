# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=saki_ai
POSTGRES_USER=saki
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_PORT=5432

# ---------------------------------------------------------------- Security
# Base64 HMAC secret, at least 256 bits. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=24h

# ---------------------------------------------------------------- Sign in with Google (optional)
# OAuth "Web application" client ID from Google Cloud Console (…apps.googleusercontent.com).
# Leave blank to hide the Google button. See README "Sign in with Google".
GOOGLE_CLIENT_ID=

# Browser origins allowed to call the API / open the WebSocket directly.
# The Docker web IDE (WEB_PORT) and the Vite dev server are included by default.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ---------------------------------------------------------------- Gemini (Saki's brain)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy ("high demand"), rate limited or retired.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
# Lower = faster voice replies; -1 = dynamic thinking.
GEMINI_THINKING_BUDGET=1024

# ---------------------------------------------------------------- Neural text-to-speech
# Provider order: the first that succeeds is used. Without any key Saki still answers (text only).
TTS_PROVIDERS=gemini,azure,google
# true = show the answer and code immediately; the voice follows a few seconds later.
TTS_ASYNC_AUDIO=true

# Gemini speech (default): uses GEMINI_API_KEY, no extra account. Speaks Sinhala and Singlish.
# Voices: Charon / Orus / Puck (male), Kore / Aoede / Leda (female).
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_SINHALA_VOICE=Charon
GEMINI_TTS_ENGLISH_VOICE=Charon

# Azure AI Speech (optional fallback): Key 1 + Region from your Speech resource ("Keys and Endpoint").
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_SINHALA_VOICE=si-LK-SameeraNeural
AZURE_ENGLISH_VOICE=en-US-AvaNeural

# Google Cloud Text-to-Speech (optional fallback). Sinhala is only tried when a
# Sinhala voice name available to your project is set below.
GOOGLE_TTS_API_KEY=
GOOGLE_SINHALA_VOICE=
GOOGLE_ENGLISH_VOICE=en-US-Neural2-F

# ---------------------------------------------------------------- Host ports
BACKEND_PORT=8080
WEB_PORT=8081

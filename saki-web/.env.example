# Only needed when the Web IDE and the backend are on different domains
# (e.g. Vercel + Render). Leave empty for local development and Docker.

# Backend URL, no trailing slash. The WebSocket URL is derived from it (https -> wss).
VITE_API_BASE_URL=

# Optional: override the WebSocket endpoint (normally not needed).
VITE_WS_URL=

# Local dev only: where the Vite dev server proxies /api and /ws.
SAKI_BACKEND_URL=http://localhost:8080
